# Dependencies
dsh-desktop/node_modules/

# 本地参考文档（不随 PR 提交）
docs/语音识别设计参考.md

# Build artifacts
dsh-desktop/dist/

# Runtime vendor (node.exe + npm, generated by fetch-runtime)
dsh-desktop/vendor/

# Runtime cache & dev data
.dev-data/
.update-test/

# openclaw-dsh-bridge (微信桥接插件) build artifacts
openclaw-dsh-bridge/node_modules/
openclaw-dsh-bridge/dist/

# 测试运行数据（dsh home / 打包探针）
dsh-desktop/.dsh-test-home/
dsh-desktop/.dsh-packaged-test/
dsh-desktop/test/.dsh-home-repro/
dsh-desktop/.dsh-test-runtime/

# 实机验证产物（.verify/：staged 运行时探针脚本、浏览器截图与状态快照）
dsh-desktop/.verify/

# Tauri 本地打包产物（bundle/nsis + portable zip；由 CI 重新生成）
tauri-shell/release/

# ACL 自动生成物：tauri-build 依据 build.rs 的 AppManifest::commands()
# 在每次构建时重建（实测：删除后 cargo check 仍成功并原样再生成）。
# 源码是 build.rs + capabilities/default.json，此处勿提交，避免与生成结果漂移。
tauri-shell/permissions/autogenerated/

# 退役 sidecar 本地产物（装配清单只带 server.js / bridge.js /
# capability-stubs.js，见 tauri-shell/stage-resources.mjs，勿随 PR 提交）
tauri-shell/sidecar/phone-bridge.js
tauri-shell/sidecar/rescue-integration.js

# 远程会话探针脚本（本地调试用，勿随 PR 提交）
probe-remote-session.cjs

# Standalone local test runtime kept outside the source tree when permissions allow
.test-runtime/

# Logs
*.log
dsh-desktop/data/

# OS
.DS_Store
Thumbs.db

# Python build artifacts (dsh-dafeiyu helper 等)
__pycache__/
*.pyc

# Temp & updater artifacts
*.tmp
updates/

# Reasonix 工具元数据（勿提交）
.reasonix/
/.hermes/
/.worktrees/
/tmp-p2boot/
/tmp-ui-verify-installed/

# verify-delete-session.js 运行产物
tmp-verify-delete/

vendor/
# full-pack 装配产物（prepare-composition.mjs 生成，约 981 MB）
# 内容是 profile-seed 的 node_modules + composition.json，属于构建输出，不入库。
dsh-desktop/assets/full-pack/
