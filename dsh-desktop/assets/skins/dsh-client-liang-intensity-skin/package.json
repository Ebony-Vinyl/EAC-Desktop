{
  "name": "dsh-client-liang-intensity-skin",
  "version": "0.1.7",
  "private": true,
  "description": "滑动变祖：an opt-in adaptive reasoning slider skin for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingOfSoySauce/dsh-liang-skin.git"
  },
  "homepage": "https://github.com/kingOfSoySauce/dsh-liang-skin#readme",
  "bugs": "https://github.com/kingOfSoySauce/dsh-liang-skin/issues",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
