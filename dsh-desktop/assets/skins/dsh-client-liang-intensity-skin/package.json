    "assets/portrait-source-v2/level-22.webp",
    "assets/portrait-source-v2/stage-24.webp",
    "assets/portrait-source-v2/level-25.webp",
    "assets/portrait-source-v2/bridge-27.webp",
    "assets/portrait-source-v2/level-28.webp",
    "assets/portrait-source-v2/level-29.webp",
