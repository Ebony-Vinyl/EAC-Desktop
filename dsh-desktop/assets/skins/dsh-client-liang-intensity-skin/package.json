    "assets/portrait-source-v2/level-10.webp",
    "assets/portrait-source-v2/stage-12.webp",
    "assets/portrait-source-v2/level-13.webp",
    "assets/portrait-source-v2/level-14.webp",
    "assets/portrait-source-v2/bridge-15.webp",
    "assets/portrait-source-v2/level-16.webp",
    "assets/portrait-source-v2/level-17.webp",
    "assets/portrait-source-v2/stage-18.webp",
    "assets/portrait-source-v2/level-19.webp",
